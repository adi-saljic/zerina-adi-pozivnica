# Server-only secrets. NEVER prefix these with VITE_ and never import them in src/.

# Neon → Project → Connection details → "Pooled connection" string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Long random string (min 32 chars). Generate: openssl rand -base64 36
ADMIN_TOKEN=

# Public site URL without trailing slash. Used for og: tags, exported links and admin.
# Locally: http://localhost:5173 (npm run dev) or http://localhost:3000 (vercel dev)
PUBLIC_BASE_URL=http://localhost:5173

# Optional override of the RSVP deadline from shared/event.ts.
# ISO 8601 WITH timezone offset, e.g. 2027-05-15T23:59:59+02:00
RSVP_DEADLINE=

# Optional: secret used to hash IP addresses for rate limiting.
# If empty, a key derived from DATABASE_URL is used.
RATE_LIMIT_SECRET=
